<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <a href="/">← Home</a>
      <h1>CSRF-Protected Form</h1>
      <p class="muted">Server validates input and requires a CSRF token.</p>

      <% if (errors && errors.length) { %>
        <section class="card danger">
          <h2>Errors</h2>
          <ul>
            <% errors.forEach(function(err) { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <% if (saved) { %>
        <section class="card success">
          <h2>Saved</h2>
          <p><strong>Name:</strong> <%= saved.name %></p>
          <p><strong>Comment:</strong> <%= saved.comment %></p>
        </section>
      <% } %>

      <form method="post" action="/comment" class="card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label>
          Name
          <input name="name" maxlength="80" value="<%= values.name %>" />
        </label>

        <label>
          Comment
          <textarea name="comment" maxlength="500" rows="4"><%= values.comment %></textarea>
        </label>

        <button type="submit">Submit</button>
      </form>
    </main>
  </body>
</html>
